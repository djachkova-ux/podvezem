rules_version = '2';

// Правила Firestore для «Подвезём». Вставлять вручную в Firebase Console →
// Firestore Database → Rules → Publish, пока CLI-деплой не настроен (S12).
// Коллекции поездок и запросов добавятся сюда своими match-блоками в S3+.
service cloud.firestore {
  match /databases/{database}/documents {
    // Профиль пользователя — читает и пишет только сам владелец.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Предложения поездок водителей — читают все авторизованные,
    // создаёт и меняет только сам водитель (владелец предложения). Отдельно
    // (S8): заказчик, отменяющий подтверждённый резерв, тоже пишет в этот
    // документ (возвращает место, переоткрывает) — не будучи владельцем,
    // поэтому разрешено точечно: только поля seatsFree/status и только
    // строго в сторону увеличения мест (иначе чужой пользователь мог бы
    // произвольно опустошать или закрывать чужие предложения).
    match /rideOffers/{offerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.driverId;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.driverId ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seatsFree', 'status']) &&
          request.resource.data.seatsFree >= resource.data.seatsFree)
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.driverId;
    }

    // Шаблоны повторяющихся предложений (S9) — сама генерация создаёт
    // независимые rideOffers (правило выше их уже покрывает), этот документ
    // только хранит параметры шаблона для истории/будущего управления.
    // Никому, кроме автора, не нужен и не виден.
    match /offerTemplates/{templateId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.driverId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.driverId;
    }

    // Запросы заказчиков на трансфер — читают все авторизованные,
    // создаёт и меняет только сам заказчик (владелец запроса).
    match /requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.customerId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.customerId;
    }

    // Отклики заказчика на предложение водителя (S6). Читают только
    // участники (сам заказчик или водитель — владелец предложения);
    // создаёт заказчик; подтверждает/отклоняет — водитель, отменяет
    // подтверждённый резерв или завершает поездку — соответственно
    // заказчик или водитель (S8), оба участника имеют право на update.
    match /responses/{responseId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.customerId || request.auth.uid == resource.data.offerDriverId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.customerId;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.offerDriverId || request.auth.uid == resource.data.customerId);
    }

    // Отклики водителя на запрос заказчика (S7), зеркально responses.
    // Читают только участники (сам водитель или заказчик — владелец
    // запроса); создаёт водитель; подтверждает/отклоняет/отменяет —
    // заказчик, завершает поездку — водитель (S8).
    match /requestResponses/{responseId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.driverId || request.auth.uid == resource.data.requestCustomerId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.driverId;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.requestCustomerId || request.auth.uid == resource.data.driverId);
    }
  }
}
