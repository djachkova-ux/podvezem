# Ключи веб-приложения из Firebase Console → Настройки проекта → Ваши приложения → Web.
# Скопировать этот файл в .env.local (он в .gitignore) и подставить значения своего проекта.
# Все переменные Vite обязаны начинаться с VITE_, иначе они не попадут в сборку.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Ключ веб-push (Firebase Console → Cloud Messaging → Web Push certificates).
# Нужен только с сессии S10, до неё можно оставить пустым.
VITE_FIREBASE_VAPID_KEY=
